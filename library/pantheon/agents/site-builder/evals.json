{
 "cases": [
  {
   "id": "a-one-page-bakery",
   "inputs": {
    "brief": "A one-page site for Rosa's Bakery: opening hours and a contact line.",
    "folder": "bakery"
   },
   "world": {
    "shell": [
     {
      "match": "mkdir",
      "output": ""
     },
     {
      "match": "http.server",
      "output": "Serving HTTP on 0.0.0.0 port 8080"
     },
     {
      "match": "curl",
      "output": "200"
     },
     {
      "match": "screenshot",
      "output": "saved"
     }
    ]
   },
   "answers": [
    "approve_task",
    "approve_task",
    "approve_task",
    "approve_task",
    "approve_task",
    "approve_task",
    "approve_task",
    "approve_task"
   ],
   "script": [
    {
     "call": [
      [
       "bash",
       {
        "command": "mkdir -p $PANTHEON_PROJECTS/bakery"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "write_file",
       {
        "path": "bakery/index.html",
        "content": "<!doctype html><title>Rosa's Bakery</title><h1>Rosa's Bakery</h1><p>Open 7–15, Tue–Sun.</p><p>hello@rosa.example</p>"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "bash",
       {
        "command": "cd $PANTHEON_PROJECTS/bakery && nohup python3 -m http.server 8080 &"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "bash",
       {
        "command": "curl -s -o /dev/null -w '%{http_code}' http://localhost:8080/"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "computer",
       {
        "action": "screenshot"
       }
      ]
     ]
    },
    {
     "say": "It answers at http://localhost:8080/ (curl: 200). Files: bakery/index.html.\n\n## Report\n- wrote 1 file, curl 200\n\n## Carry forward\n- bakery served on 8080"
    }
   ],
   "checks": [
    {
     "file": {
      "path": "bakery/index.html",
      "contains": [
       "Rosa's Bakery",
       "Open"
      ]
     }
    },
    {
     "answer_contains": [
      "localhost:8080"
     ]
    }
   ]
  },
