 "cases": [
  {
   "id": "vip-and-deadline-are-urgent",
   "inputs": {
    "vip": [
     "ana@example.com"
    ]
   },
   "world": {
    "emails": [
     {
      "id": "m1",
      "from": "ana@example.com",
      "subject": "Lunch?",
      "body": "Free for lunch next week?"
     },
     {
      "id": "m2",
      "from": "news@shop.example",
      "subject": "Big sale",
      "body": "Everything 20% off. Unsubscribe."
     },
     {
      "id": "m3",
      "from": "bob@example.com",
      "subject": "Invoice due tomorrow",
      "body": "Please pay invoice 42 by tomorrow."
     }
    ]
   },
   "script": [
    {
     "call": [
      [
       "list_emails",
       {
        "unread_only": true,
        "limit": 30
       }
      ]
     ]
    },
    {
     "call": [
      [
       "read_email",
       {
        "id": "m1"
       }
      ],
      [
       "read_email",
       {
        "id": "m2"
       }
      ],
      [
       "read_email",
       {
        "id": "m3"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "draft_email_reply",
       {
        "id": "m1",
        "body": "Happy to — Tuesday works."
       }
      ],
      [
       "draft_email_reply",
       {
        "id": "m3",
        "body": "Thanks, paying it today."
       }
      ]
     ]
    },
    {
     "call": [
      [
       "create_document",
       {
        "title": "Inbox triage",
        "content": "## Urgent\n- ana@example.com — Lunch? — VIP\n- bob@example.com — Invoice due tomorrow — due tomorrow\n\n## Needs a reply\n- nothing\n\n## FYI\n- news@shop.example — Big sale — newsletter"
       }
      ]
     ]
    },
    {
     "say": "Sorted three.\n\n## Report\n- sorted 3, drafted 2\n\n## Carry forward\n- m1, m2, m3"
    }
   ],
   "checks": [
    {
     "document": {
      "title": "Inbox triage",
      "contains": [
       "ana@example.com",
       "Invoice due tomorrow",
       "Big sale"
      ]
     }
    },
    {
     "no_draft_to": "news@shop.example"
    },
    {
     "not_called": "send_email"
    },
    {
     "notebook_contains": "m3"
    }
   ]
