 "cases": [
  {
   "id": "vip-and-deadline-are-urgent",
   "about": "A VIP's lunch question and an invoice due tomorrow are Urgent and drafted; the sale newsletter is FYI and gets no draft.",
   "inputs": {
    "vip": [
     "ana@example.com"
    ]
   },
   "world": {
    "emails": [
     {
      "id": "m1",
      "from": "ana@example.com",
      "subject": "Lunch?",
      "body": "Free for lunch next week?"
     },
     {
      "id": "m2",
      "from": "news@shop.example",
      "subject": "Big sale",
      "body": "Everything 20% off. Unsubscribe."
     },
     {
      "id": "m3",
      "from": "bob@example.com",
      "subject": "Invoice due tomorrow",
      "body": "Please pay invoice 42 by tomorrow."
     }
    ]
   },
   "script": [
    {
     "call": [
      [
       "list_emails",
       {
        "unread_only": true,
        "max_results": 30
       }
      ]
     ]
    },
    {
     "call": [
      [
       "read_email",
       {
        "uid": "m1"
       }
      ],
      [
       "read_email",
       {
        "uid": "m2"
       }
      ],
      [
       "read_email",
       {
        "uid": "m3"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "draft_email_reply",
       {
        "uid": "m1",
        "body": "Happy to — would Tuesday suit you?"
       }
      ],
      [
       "draft_email_reply",
       {
        "uid": "m3",
        "body": "Thanks Bob — I'll come back to you on invoice 42 today."
       }
      ]
     ]
    },
    {
     "call": [
      [
       "create_document",
       {
        "title": "Inbox triage — 27 Oct",
        "content": "## Urgent\n- ana@example.com — Lunch? — VIP (draft made)\n- bob@example.com — Invoice due tomorrow — due tomorrow (draft made)\n\n## Needs a reply\n- nothing\n\n## FYI\n- news@shop.example — Big sale — newsletter"
       }
      ]
     ]
    },
    {
     "say": "Sorted 3: 2 urgent, 0 needs a reply, 1 FYI. Drafted 2 replies.\n\n## Report\n- sorted 3, drafted 2\n\n## Carry forward\n- sorted: m1, m2, m3"
    }
   ],
   "checks": [
    {
     "document": {
      "title": "Inbox triage",
      "contains": [
       "ana@example.com",
       "Invoice due tomorrow",
       "Big sale"
      ]
     }
    },
    {
     "no_draft_to": "news@shop.example"
    },
    {
     "not_called": "send_email"
    },
    {
     "notebook_contains": "m3"
    }
   ]
  },
