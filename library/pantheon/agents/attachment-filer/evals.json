{
 "cases": [
  {
   "id": "two-attachments-filed-by-their-rules",
   "about": "An invoice and the school's letter are saved into the folders their rules name, each with the person's yes; the holiday photo matches no rule and is left; the uids are carried forward.",
   "inputs": {
    "rules": "hostly -> invoices\nschool -> school"
   },
   "world": {
    "emails": [
     {
      "id": "m1",
      "from": "billing@hostly.example",
      "subject": "Invoice INV-42",
      "date": "2026-10-27",
      "body": "Your invoice is attached.",
      "attachments": [
       {
        "filename": "invoice-42.pdf",
        "content": "Hostly invoice INV-42: 12.00 USD"
       }
      ]
     },
     {
      "id": "m2",
      "from": "office@school.example",
      "subject": "Term dates for spring",
      "date": "2026-10-27",
      "body": "Please find the term dates attached.",
      "attachments": [
       {
        "filename": "term-dates.pdf",
        "content": "Spring term: 5 Jan to 27 Mar"
       }
      ]
     },
     {
      "id": "m3",
      "from": "dan@example.com",
      "subject": "Photos from the weekend",
      "date": "2026-10-27",
      "body": "Here you go.",
      "attachments": [
       {
        "filename": "holiday.jpg",
        "content": "JPEG"
       }
      ]
     }
    ],
    "files": {
     "invoices/.keep": "",
     "school/.keep": ""
    }
   },
   "answers": [
    "approve_task",
    "approve_task"
   ],
   "script": [
    {
     "call": [
      [
       "list_emails",
       {
        "unread_only": true,
        "max_results": 20
       }
      ]
     ]
    },
    {
     "call": [
      [
       "read_email",
       {
        "uid": "m1"
       }
      ],
      [
       "read_email",
       {
        "uid": "m2"
       }
      ],
      [
       "read_email",
       {
        "uid": "m3"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "ls",
       {
        "path": "invoices"
       }
      ],
      [
       "ls",
       {
        "path": "school"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "download_attachment",
       {
        "uid": "m1",
        "index": 0,
        "destination": "invoices",
        "filename": "invoice-42.pdf"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "download_attachment",
       {
        "uid": "m2",
        "index": 0,
        "destination": "school",
        "filename": "term-dates.pdf"
       }
      ]
     ]
    },
    {
     "say": "**Filed**\n- invoices/invoice-42.pdf — billing@hostly.example — rule \"hostly -> invoices\"\n- school/term-dates.pdf — office@school.example — rule \"school -> school\"\n\n**Not filed**\n- dan@example.com — holiday.jpg — no rule matched\n\n## Report\n- read 3 new messages; saved 2 attachments with your yes; left 1\n\n## Carry forward\n- handled: m1, m2, m3"
    }
   ],
   "checks": [
    {
     "file": {
      "path": "invoices/invoice-42.pdf",
      "contains": [
       "INV-42"
      ]
     }
    },
    {
     "file": {
      "path": "school/term-dates.pdf",
      "contains": [
       "Spring term"
      ]
     }
    },
    {
     "answer_contains": [
      "holiday.jpg — no rule matched"
     ]
    },
    {
     "notebook_contains": "m3"
    }
   ]
  },
