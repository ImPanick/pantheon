{
 "cases": [
  {
   "id": "an-ordinary-day",
   "about": "One meeting, one person's mail and one note due: the newsletter is left out, and each heading carries its own.",
   "inputs": {
    "at": "07:00"
   },
   "world": {
    "calendar": [
     {
      "summary": "Dentist",
      "start": "today 15:00",
      "location": "12 High St"
     }
    ],
    "emails": [
     {
      "id": "m1",
      "from": "ana@example.com",
      "subject": "Contract for Friday",
      "body": "Can you sign by Friday?"
     },
     {
      "id": "m2",
      "from": "news@shop.example",
      "subject": "Weekly deals",
      "body": "Sale. Unsubscribe."
     }
    ],
    "notes": [
     {
      "title": "Renew passport",
      "content": "Form at the post office",
      "due": "today"
     }
    ]
   },
   "script": [
    {
     "call": [
      [
       "manage_calendar",
       {
        "action": "list_events"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "list_emails",
       {
        "unread_only": true,
        "max_results": 20
       }
      ]
     ]
    },
    {
     "call": [
      [
       "manage_notes",
       {
        "action": "list"
       }
      ]
     ]
    },
    {
     "call": [
      [
       "manage_tasks",
       {
        "action": "list"
       }
      ]
     ]
    },
    {
     "say": "**Today**\n- 15:00 Dentist — 12 High St\n\n**Mail that needs you**\n- ana@example.com — Contract for Friday — wants it signed by Friday\n\n**Due**\n- Renew passport (due today)\n\n**Overnight**\n- nothing\n\n## Report\n- read 1 event, 2 unread messages (1 kept), 1 note, 1 scheduled task\n\n## Carry forward\n- nothing"
    }
   ],
   "checks": [
    {
     "answer_contains": [
      "Dentist",
      "Contract for Friday",
      "passport"
     ]
    },
    {
     "answer_lacks": [
      "Weekly deals"
     ]
    },
    {
     "not_called": "send_email"
    },
    {
     "status": "success"
    }
   ]
  },
