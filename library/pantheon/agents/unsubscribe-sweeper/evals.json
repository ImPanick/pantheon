 "cases": [
  {
   "id": "never-opened-senders-are-listed",
   "about": "A shop that is never opened goes on the list with its mailto; a newsletter that is read is kept; nothing is unsubscribed without the person's word.",
   "inputs": {
    "months": 3
   },
   "world": {
    "emails": [
     {
      "id": "d0",
      "from": "deals@shop.example",
      "subject": "Deal 0",
      "unread": true,
      "unsubscribe": "mailto:unsub@shop.example",
      "body": "Sale! Unsubscribe."
     },
     {
      "id": "d1",
      "from": "deals@shop.example",
      "subject": "Deal 1",
      "unread": true,
      "unsubscribe": "mailto:unsub@shop.example",
      "body": "Sale! Unsubscribe."
     },
     {
      "id": "d2",
      "from": "deals@shop.example",
      "subject": "Deal 2",
      "unread": true,
      "unsubscribe": "mailto:unsub@shop.example",
      "body": "Sale! Unsubscribe."
     },
     {
      "id": "n0",
      "from": "news@energyweekly.example",
      "subject": "Issue 0",
      "unread": false,
      "unsubscribe": "mailto:leave@energyweekly.example",
      "body": "Issue. Unsubscribe."
     },
     {
      "id": "n1",
      "from": "news@energyweekly.example",
      "subject": "Issue 1",
      "unread": false,
      "unsubscribe": "mailto:leave@energyweekly.example",
      "body": "Issue. Unsubscribe."
     }
    ]
   },
   "script": [
    {
     "call": [
      [
       "scan_email_unsubscribes",
       {
        "limit": 25,
        "max_scan": 150
       }
      ]
     ]
    },
    {
     "call": [
      [
       "search_emails",
       {
        "query": "deals@shop.example",
        "max_results": 20
       }
      ],
      [
       "search_emails",
       {
        "query": "news@energyweekly.example",
        "max_results": 20
       }
      ]
     ]
    },
    {
     "call": [
      [
       "create_document",
       {
        "title": "Unsubscribe list — November 2026",
        "content": "## Never opened\n- Shop Deals — deals@shop.example — 3 messages — mailto:unsub@shop.example\n\n## Unsubscribed\n- nothing\n\n## Kept\n- Energy Weekly — news@energyweekly.example — opened 2 of 2"
       }
      ]
     ]
    },
    {
     "say": "1 never opened, 0 unsubscribed, 1 kept.\n\n## Report\n- scanned the inbox, sorted 2 senders\n\n## Carry forward\n- never opened in November: deals@shop.example"
    }
   ],
   "checks": [
    {
     "document": {
      "title": "Unsubscribe list",
      "contains": [
       "deals@shop.example",
       "mailto:unsub@shop.example",
       "opened 2 of 2"
      ]
     }
    },
    {
     "not_called": "unsubscribe_email"
    }
   ]
