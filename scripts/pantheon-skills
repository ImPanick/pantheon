#!/usr/bin/env python3
"""pantheon-skills — shell wrapper for AI skill scripts.

Skills are `SKILL.md` files under `data/skills/<category>/<name>/`. Each
captures a reusable how-to the assistant has learned. This CLI lets you
list, inspect, and prune them from the shell.

    pantheon-skills list [--category general]
    pantheon-skills show SKILL_NAME
    pantheon-skills categories
    pantheon-skills delete SKILL_NAME
    pantheon-skills export SKILL_NAME --raw      # full SKILL.md to stdout
    pantheon-skills draft "what you did, in your own words" [--save]

`draft` is the one you want if you have never written a SKILL.md. Say what
you did the way you would say it to a colleague and the configured model
fills in the ten fields the format wants — the trigger phrase retrieval
matches on, the steps, the pitfalls, how to check it worked. It prints the
draft for you to read; `--save` writes it, and nothing is written without it.
"""

from __future__ import annotations
import sys
import os, sys
sys.path.insert(0, os.path.join(os.path.dirname(__file__), "_lib"))
from cli import quiet_logs, emit, fail, common_parser, run, REPO_ROOT as _REPO_ROOT
quiet_logs()

import argparse, json, logging, os, shutil, sys
from pathlib import Path

try:
    from services.memory.skills import SkillsManager
    quiet_logs()
except ModuleNotFoundError as e:
    sys.stderr.write(f"error: {e}\nhint: run from repo root with venv active.\n")
    sys.exit(2)


_DATA_DIR = str(_REPO_ROOT / "data")
_mgr: SkillsManager | None = None


def _manager() -> SkillsManager:
    global _mgr
    if _mgr is None:
        _mgr = SkillsManager(_DATA_DIR)
    return _mgr


def _preview_text(value, limit: int = 200) -> str:
    """Truncated preview of a text field, tolerant of non-string values.

    A skill whose ``description`` is a non-string (e.g. a number from a
    hand-edited/legacy store) would crash ``(value or "")[:200]`` with a
    TypeError; coerce non-strings to "" instead.
    """
    text = value if isinstance(value, str) else ""
    return text[:limit]


def _skill_entries(skills):
    return [s for s in skills or [] if isinstance(s, dict)]


def _summary(skill: dict) -> dict:
    return {
        "name": skill.get("name", ""),
        "category": skill.get("category", "general"),
        "description": _preview_text(skill.get("description")),
        "status": skill.get("status", ""),
        "uses": skill.get("uses", 0),
        "last_used": skill.get("last_used") or "",
        "tags": skill.get("tags") or [],
    }


def cmd_list(args):
    out = _skill_entries(_manager().load_all())
    if args.category:
        out = [s for s in out if (s.get("category") or "general") == args.category]
    out.sort(key=lambda s: (-int(s.get("uses") or 0), s.get("name", "")))
    emit([_summary(s) for s in out[: args.limit]], args)


def cmd_show(args):
    for s in _skill_entries(_manager().load_all()):
        if s.get("name") == args.name:
            emit(s, args)
            return
    fail(f"no skill named {args.name!r}")


def cmd_categories(args):
    counts: dict[str, int] = {}
    for s in _skill_entries(_manager().load_all()):
        c = s.get("category") or "general"
        counts[c] = counts.get(c, 0) + 1
    emit([{"category": c, "count": n} for c, n in sorted(counts.items())], args)


def cmd_delete(args):
    # Locate the skill's directory and rm -rf it.
    skills_root = Path(_DATA_DIR) / "skills"
    for s in _skill_entries(_manager().load_all()):
        if s.get("name") != args.name:
            continue
        cat = s.get("category") or "general"
        path = skills_root / cat / s["name"]
        if path.is_dir():
            shutil.rmtree(path)
            emit({"ok": True, "deleted": s.get("name"), "path": str(path)}, args)
            return
        fail(f"skill record found but directory missing: {path}")
    fail(f"no skill named {args.name!r}")


def cmd_export(args):
    for s in _skill_entries(_manager().load_all()):
        if s.get("name") != args.name:
            continue
        cat = s.get("category") or "general"
        md_path = Path(_DATA_DIR) / "skills" / cat / args.name / "SKILL.md"
        if not md_path.exists():
            fail(f"SKILL.md missing for {args.name!r}")
        if args.raw:
            sys.stdout.write(md_path.read_text())
            return
        emit({
            "name": args.name,
            "category": cat,
            "path": str(md_path),
            "content": md_path.read_text(),
        }, args)
        return
    fail(f"no skill named {args.name!r}")


# `P8-14` — "draft from my last session", from a sentence rather than a trace.
#
# The row's original framing was to retarget the teacher's skill-from-trace
# prompt. That prompt cannot be retargeted: its slots are failure-shaped and
# its body tells the model it is holding a tool trace that already worked. The
# schema and the portability rules — the input-agnostic half — are now
# `services/memory/skill_prompts`, and this is the third caller to compose
# them under its own framing, beside the session extractor and the teacher.
#
# This is the door. The Workshop's own button needs `static/js/skills.js` and
# a `POST /api/skills/draft` beside `POST /api/skills/lint`, which is the same
# not-written, answer-a-question shape; both are named in the row.
def cmd_draft(args):
    import asyncio

    from services.memory.skill_extractor import draft_skill_from_description
    from services.memory.skill_lint import lint_skill
    from src.endpoint_resolver import resolve_endpoint

    text = (args.description or "").strip()
    if not text:
        fail("say what you did — `pantheon-skills draft \"I ...\"`")

    # The same resolution the skill test uses: the configured Default/Utility
    # model, not whatever a chat session happens to be on.
    url, model, headers = resolve_endpoint("utility", owner=args.owner)
    if not url or not model:
        fail("no model configured — set a Default or Utility model in "
             "Settings first; this command asks it to write the draft.", code=2)

    draft = asyncio.run(draft_skill_from_description(
        text, endpoint_url=url, model=model, headers=headers,
    ))
    if not draft:
        fail("that does not read as a repeatable procedure yet. Say what you "
             "actually ran and how you knew it had worked.", code=1)

    mgr = _manager()
    siblings = [s for s in _skill_entries(mgr.load(owner=args.owner))
                if (s.get("name") or "") != (draft.get("name") or "")]
    # The same lint the Workshop form and the nightly audit use, so a drafted
    # skill and a typed one are judged on one scale (`Law 14`).
    report = lint_skill(draft, siblings)

    if not args.save:
        emit({"saved": False, "model": model, "skill": draft, "lint": report,
              "next": "re-run with --save to write it, or edit the fields first"},
             args)
        return

    entry = mgr.add_skill(
        name=draft.get("name") or "",
        description=draft.get("description") or "",
        category=draft.get("category") or "general",
        tags=draft.get("tags") or [],
        when_to_use=draft.get("when_to_use") or "",
        procedure=draft.get("procedure") or [],
        pitfalls=draft.get("pitfalls") or [],
        verification=draft.get("verification") or [],
        # `source="user"` for the same reason `POST /api/skills/add` uses it:
        # a person asked for this one, so it is exempt from dedup-at-creation
        # and from cap-eviction. The overlap is reported rather than enforced.
        source="user",
        owner=args.owner,
    )
    emit({"saved": True, "model": model, "name": entry.get("name"),
          "status": entry.get("status"), "lint": report,
          "overlaps": entry.get("_overlaps") or []}, args)


def _build_parser():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pretty", action="store_true")
    p = argparse.ArgumentParser(prog="pantheon-skills", parents=[common])
    sub = p.add_subparsers(dest="cmd", required=True)

    pl = sub.add_parser("list", parents=[common])
    pl.add_argument("--category")
    pl.add_argument("--limit", type=int, default=100)
    pl.set_defaults(func=cmd_list)

    psh = sub.add_parser("show", parents=[common])
    psh.add_argument("name")
    psh.set_defaults(func=cmd_show)

    pc = sub.add_parser("categories", parents=[common])
    pc.set_defaults(func=cmd_categories)

    pd = sub.add_parser("delete", parents=[common])
    pd.add_argument("name")
    pd.set_defaults(func=cmd_delete)

    pe = sub.add_parser("export", parents=[common])
    pe.add_argument("name")
    pe.add_argument("--raw", action="store_true", help="write raw SKILL.md to stdout")
    pe.set_defaults(func=cmd_export)

    pdr = sub.add_parser(
        "draft", parents=[common],
        help="write a SKILL.md from what you did, described in your own words",
        description=(
            "Write a SKILL.md from what you did, described in your own words. "
            "You do not need to know the file format, or what a trigger phrase "
            "or a verification step is — say what you did the way you would "
            "say it to a colleague and the configured model fills the fields "
            "in. The draft is printed for you to read; it is written only if "
            "you pass --save."
        ),
        epilog=(
            'example:\n  pantheon-skills draft "the print queue jammed so I '
            "stopped the spooler, cleared the spool folder and started it "
            'again; a test page proved it" --save'
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    pdr.add_argument(
        "description",
        help="what you did, the way you would say it to a colleague",
    )
    pdr.add_argument("--save", action="store_true",
                     help="write the draft to the library (default: print it)")
    pdr.add_argument("--owner", default=None,
                     help="whose library to write to on a multi-user install")
    pdr.set_defaults(func=cmd_draft)

    return p


if __name__ == "__main__":
    sys.exit(run(_build_parser()))
