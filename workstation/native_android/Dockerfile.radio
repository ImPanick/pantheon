# `B2194`. The image's own Python patch release, by tag and digest, so Dependabot
# can see and move it (a bare digest named no release to compare against).
FROM python:3.14.10-slim@sha256:22eafb370920ad8b429e0aec3fff433e0669968519f5d60469d83729c138b28b
RUN apt-get update && apt-get install -y --no-install-recommends nftables && rm -rf /var/lib/apt/lists/*
COPY workstation /opt/pantheon/workstation
ENV PYTHONPATH=/opt/pantheon
ENTRYPOINT ["python3", "-m", "workstation.native_android.radio_init"]
