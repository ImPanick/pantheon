FROM python@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
RUN apt-get update && apt-get install -y --no-install-recommends nftables && rm -rf /var/lib/apt/lists/*
COPY workstation /opt/pantheon/workstation
ENV PYTHONPATH=/opt/pantheon
ENTRYPOINT ["python3", "-m", "workstation.native_android.radio_init"]
